{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "packages/ai/*": ["../../packages/ai/*"],
      "packages/agents/*": ["../../packages/agents/*"],
      "packages/memory/*": ["../../packages/memory/*"],
      "packages/ai-router/*": ["../../packages/ai-router/*"],
      "packages/security": ["../../packages/security"],
      "packages/security/*": ["../../packages/security/*"]
    }
  },
  "include": [
    "next-env.d.ts", 
    "**/*.ts", 
    "**/*.tsx", 
    ".next/types/**/*.ts", 
    "../../packages/ai/**/*.ts",
    "../../packages/agents/**/*.ts",
    "../../packages/memory/**/*.ts",
    "../../packages/ai-router/**/*.ts",
    "../../packages/security/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
