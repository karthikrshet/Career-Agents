# ─── Career OS — Production Environment Configurations ────────────────────────

# App Details & General Settings
NEXT_PUBLIC_APP_NAME="Career OS"
NEXT_PUBLIC_APP_VERSION="3.0.0"
NEXT_PUBLIC_SITE_URL="https://career-agents.vercel.app"

# ─── Database Configurations ──────────────────────────────────────────────────
# PostgreSQL database connection string (used by Prisma if self-hosting / server-side persistence is enabled)
# If left blank, Career OS defaults to local client-side Zustand JSON storage (localStorage)
DATABASE_URL="h"

# ─── Authentication Configurations ─────────────────────────────────────────────
# NextAuth standard setup. Generate secret using: openssl rand -base64 32
NEXTAUTH_URL="https://career-agents.vercel.app"
NEXTAUTH_SECRET="your-nextauth-cryptographic-secret-here"
JWT_SECRET="your-jwt-signing-secret-here"

# OAuth Integration Clients
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─── AI Gateway Providers API Keys ────────────────────────────────────────────
# The AI Gateway manages multi-provider fallback, health audits and key rotations.
# These server env variables act as default fallbacks if users do not supply client keys.

# Primary Default Setup
DEFAULT_PROVIDER="gemini"
DEFAULT_MODEL="gemini-2.5-flash"

# Google Gemini API
GEMINI_API_KEY="AIzaSy..."

# OpenAI API Key
OPENAI_API_KEY="sk-proj-..."

# Anthropic Claude API Key
ANTHROPIC_API_KEY="sk-ant-..."

# Groq API Key
GROQ_API_KEY=""

# OpenRouter (aggregates 200+ models)
OPENROUTER_API_KEY="sk-or-..."

# DeepSeek API Key
DEEPSEEK_API_KEY="sk-..."

# Mistral AI API Key
MISTRAL_API_KEY="sk-..."

# Cohere API Key
COHERE_API_KEY="sk-..."

# Together AI Key
TOGETHER_API_KEY="sk-..."

# xAI Grok Key
XAI_API_KEY="sk-..."

# Azure OpenAI Setup
AZURE_OPENAI_API_KEY="sk-..."
AZURE_OPENAI_ENDPOINT="https://your-deployment-name.openai.azure.com"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# Local AI Endpoints (No Auth Needed)
OLLAMA_BASE_URL="http://localhost:11434/v1"
LMSTUDIO_BASE_URL="http://localhost:1234/v1"

# ─── File Upload Limits ───────────────────────────────────────────────────────
# Maximum file upload size allowed for resume PDF files, images or JSON audits
UPLOAD_LIMIT_MB=10

# ─── Telemetry & Features ─────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_MCP="true"
NEXT_PUBLIC_ENABLE_MARKETPLACE="true"
NEXT_PUBLIC_ENABLE_REPORTS="true"
NEXT_PUBLIC_ENABLE_TELEMETRY="false"
