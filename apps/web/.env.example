# Career OS — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (required for full persistence)
# If not set, Career OS uses local JSON storage (localStorage)
DATABASE_URL="postgresql://user:password@localhost:5432/career_os"

# ─── NextAuth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth Providers ──────────────────────────────────────────────────────
# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─── AI Providers ─────────────────────────────────────────────────────────
# Users configure their own API keys in Settings → AI Provider
# These server-side env vars are used as fallbacks for API routes

# Groq (free tier — recommended for default)
# Get at: https://console.groq.com
GROQ_API_KEY="gsk_..."

# OpenAI
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Anthropic Claude
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# OpenRouter (access to 200+ models via one key)
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."

# DeepSeek
# Get at: https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-..."

# Azure OpenAI
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""

# ─── GitHub API ───────────────────────────────────────────────────────────
# Optional: adds 5000 req/hr to GitHub API calls (vs 60 unauthenticated)
# Get at: https://github.com/settings/tokens
GITHUB_TOKEN=""

# ─── Feature Flags ────────────────────────────────────────────────────────
# Enable/disable features (true/false)
NEXT_PUBLIC_ENABLE_MCP="true"
NEXT_PUBLIC_ENABLE_MARKETPLACE="true"
NEXT_PUBLIC_ENABLE_REPORTS="true"
NEXT_PUBLIC_ENABLE_TELEMETRY="false"

# ─── App Config ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Career OS"
NEXT_PUBLIC_APP_VERSION="2.0.0"
